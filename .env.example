# Токен бота: Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Серверний час гри = польський (Берлін і Варшава мають однаковий пояс).
# Якщо перший спавн Watcher Kaira у грі не збігся з ботом, скажи, змінимо на Asia/Seoul.
SERVER_TZ=Europe/Warsaw

# Канали (ID: ПКМ по каналу -> Копіювати ID, потрібен режим розробника)
ABYSS_CHANNEL_ID=
FIELD_CHANNEL_ID=

# Необов'язково: роль для пінгу (ID ролі)
ABYSS_ROLE_ID=
FIELD_ROLE_ID=

# За скільки хвилин до спавну попереджати
REMIND_MINUTES=10
